# WhatsApp Cloud API Credentials
# Get these from Meta for Developers (https://developers.facebook.com/)
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_verification_token_here

# Google Gemini API Key (Optional - when TEST_MODE = False)
GEMINI_API_KEY=your_gemini_api_key_here
